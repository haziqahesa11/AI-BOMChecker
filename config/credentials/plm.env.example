# One JWT per site, matched by the running host's IP prefix (see monica-automation/monica/plm_client.py).
# Fill in real values in a sibling "plm.env" (gitignored) — never here.
PLM_JWT_WYMX=
PLM_JWT_WZS=
PLM_JWT_WYTN=
PLM_JWT_WCZ=
PLM_JWT_WYHQ_VCS=

# Optional: force a specific site's JWT regardless of detected IP prefix
# (needed when running off-site, e.g. from a dev laptop not in any listed subnet).
PLM_SITE_CODE=
