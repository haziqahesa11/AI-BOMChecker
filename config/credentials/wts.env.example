# Azure DevOps PAT used by HQ Fetching/wts_dashboard/wts_fetch.py to query
# WiwynnTrackingSystem work items. Never commit the real token.
AZURE_DEVOPS_PAT=

# Absolute path where wts_fetch.py writes WTS/ (attachments + index.json) and
# Log/ (fetch logs), and where the BackEnd (MSFT Projects page) reads from.
# Must exist and be writable by whoever runs wts_fetch.py, readable by the
# BackEnd process.
WTS_DATA_DIR=
