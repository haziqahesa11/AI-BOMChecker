# Base URL of the Ollama server the AI Dashboard's prediction narrative calls.
# Ollama runs on NEXAi (192.168.100.2), reachable from WYMY-NEXA (10.251.231.79,
# where BOMGUARD's live backend runs as PM2 process "ai-bom-online") over the same
# network path NexaiDataExtractor uses. Not reachable from an arbitrary laptop off
# that network — verify with `curl $OLLAMA_BASE_URL/api/tags` before relying on it.
# If this is unset or unreachable, the AI Dashboard still works — it just shows
# "AI narrative unavailable" instead of a generated prediction; nothing else breaks.
OLLAMA_BASE_URL=http://192.168.100.2:11434

# Name of the Ollama model to use for the prediction narrative (e.g. one already
# pulled on that server — check with `ollama list` on NEXAi).
OLLAMA_MODEL=llama3.1
