# Base URL of the Ollama server the AI Dashboard's prediction narrative calls.
# Ollama runs on NEXAi (192.168.100.2), reachable from WYMY-NEXA (10.251.231.79,
# where BOMGUARD's live backend runs as PM2 process "ai-bom-online") over the same
# network path NexaiDataExtractor uses. Not reachable from an arbitrary laptop off
# that network — verify with `curl $OLLAMA_BASE_URL/api/tags` before relying on it.
# If this is unset or unreachable, the AI Dashboard still works — it just shows
# "AI narrative unavailable" instead of a generated prediction; nothing else breaks.
#
# Testing from a laptop that can't reach 192.168.100.2 directly (confirmed 2026-08):
# open an SSH local port-forward through WYMY-NEXA —
#   ssh -N -L 11434:192.168.100.2:11434 engineer@10.251.231.79
# — then set OLLAMA_BASE_URL=http://localhost:11434 below instead, and restart this
# app's process (`pm2 restart <name> --update-env` if PM2-managed) so it picks up the
# change; dotenv only loads at process startup, not per-request.
OLLAMA_BASE_URL=http://192.168.100.2:11434

# Name of the Ollama model to use for the prediction narrative — must be a tag
# actually pulled on that server (check with `ollama list` / `curl
# $OLLAMA_BASE_URL/api/tags`). Confirmed pulled on NEXAi as of 2026-08: qwen2.5:3b,
# gemma3:4b(-fast), phi4:14b, qwen2.5:7b, qwen2.5:14b, llama3.3:70b(-instruct-q4_K_M),
# llama3.1:8b. llama3.1:8b is a reasonable default — fast enough for an interactive
# dashboard request; the 70b variants are much slower.
OLLAMA_MODEL=llama3.1:8b
