# NexaiDataExtractor settings. Copy this file to nexai_extractor.env (same folder)
# and fill in real values — nexai_extractor.env itself is gitignored, same as every
# other <system>.env file in this folder (see config/credentials/README.md).

# Base URL of the AI-BOM REST API this extractor pulls from (WYMY-NEXA host, PM2
# process "ai-bom-online"). NOTE (2026-08-11): as of this writing, that live instance
# is running an older build that's missing /api/cycle-time/*, /api/first-pass-yield/*,
# /api/tpa-history, and /api/golden-template/* — the extractor treats those as
# "unavailable" per-source (never a crash) and will pick them up automatically once
# that box is redeployed with the current BackEnd/. See README.md.
AI_BOM_API_BASE_URL=http://10.251.231.79:8000

# Root output directory for the markdown library on NEXAi (created if missing).
DATA_COMPILATION_DIR=/home/engineer/AI-BOM/Data_Compilation

# Earliest date treated as "the beginning" for event sources (Cycle Time, TPA History,
# FPY raw blade fail data). Widen this if manufacturing/SFCS data goes back further —
# querying too wide a range costs nothing, the DB just returns nothing for periods
# with no data.
HISTORY_EPOCH=2015-01-01

# Caps rows/entities per markdown file so files stay a sane size for a RAG chunker.
MAX_ENTITIES_PER_FILE=300

# Size (days) of each catch-up window when advancing an event source's cursor.
CHUNK_DAYS=30
